      "created_at": "2026-08-17T20:28:48.507Z",
      "updated_at": "2026-08-17T20:28:48.507Z"
    },
    {
      "id": 460,
      "machine_id": 26,
      "point_text": "قم بعمل (Zero Test) لساعات قياس الضغط لخطوط المياه.",
      "result_type": "text",
      "sort_order": 8,
      "is_active": true,
      "deactivated_at": null,
      "created_at": "2026-08-17T20:28:48.507Z",
      "updated_at": "2026-08-17T20:28:48.507Z"
    },
    {
      "id": 461,
      "machine_id": 26,
      "point_text": "قم بفحص ساعات الحرارة على خطوط المياه، وتأكد من عدم كسرها وسلامة التدريج.",
      "result_type": "text",
      "sort_order": 9,
      "is_active": true,
      "deactivated_at": null,
      "created_at": "2026-08-17T20:28:48.507Z",
      "updated_at": "2026-08-17T20:28:48.507Z"
    },
    {
      "id": 462,
      "machine_id": 26,
      "point_text": "افحص مرابط أبواب الماكينة، وأن إغلاقها يتم بشكل جيد.",
