      "sort_order": 10,
      "is_active": true,
      "deactivated_at": null,
      "created_at": "2026-08-17T20:28:48.507Z",
      "updated_at": "2026-08-17T20:28:48.507Z"
    },
    {
      "id": 463,
      "machine_id": 26,
      "point_text": "تأكد من عدم وجود \"صوت إزعاج\" صادر من الماكينة",
      "result_type": "text",
      "sort_order": 11,
      "is_active": true,
      "deactivated_at": null,
      "created_at": "2026-08-17T20:28:48.507Z",
      "updated_at": "2026-08-17T20:28:48.507Z"
    },
    {
      "id": 464,
      "machine_id": 26,
      "point_text": "تأكد أن لون السائل داخل U tube Manometer أحمر ولا يوجد به تقطيع",
      "result_type": "text",
      "sort_order": 12,
      "is_active": true,
